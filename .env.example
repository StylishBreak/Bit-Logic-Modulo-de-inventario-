# Copia este archivo como .env solo como referencia; Node no lo lee automáticamente.
# En Render estas variables se configuran en el panel (Environment) o en render.yaml.

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP
PORT=3000
# Secreto para firmar los JWT (mínimo 32 caracteres). Obligatorio en producción.
JWT_SECRET=
# Vigencia del token en segundos (3600 = 1 hora)
JWT_EXPIRA_SEGUNDOS=3600
# Archivo de la base SQLite
DB_PATH=data/inventario.db
# Intentos de inicio de sesión permitidos por ventana de tiempo
LOGIN_MAX_INTENTOS=20
LOGIN_VENTANA_MINUTOS=15
# Contraseñas incorrectas permitidas por cuenta antes de bloquearla durante la ventana
LOGIN_MAX_FALLOS_CUENTA=10
# true cuando la app corre detrás de un proxy (Render) para leer la IP real
TRUST_PROXY=false
# Zona horaria para calcular caducidades
ZONA_HORARIA=America/Mexico_City
# Días antes de la caducidad para marcar "por caducar"
DIAS_ALERTA_CADUCIDAD=7
